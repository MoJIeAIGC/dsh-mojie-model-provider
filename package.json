{
  "name": "@mojieai/dsh-mojie-model-provider",
  "description": "Standalone DeepSeek Harness (dsh) plugin: Mojie (mojieaigc.com) LLM model provider",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "default": "./lib/core/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/clean-lib.mjs && tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "clean": "node scripts/clean-lib.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "check:catalog": "node scripts/sync-catalog.mjs --check",
    "market:index": "node scripts/build-market-index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoJIeAIGC/dsh-mojie-model-provider.git"
  },
  "bugs": {
    "url": "https://github.com/MoJIeAIGC/dsh-mojie-model-provider/issues"
  },
  "homepage": "https://github.com/MoJIeAIGC/dsh-mojie-model-provider#readme",
  "dependencies": {
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/dsh-attachment": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
